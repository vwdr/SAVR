{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://savr.local/schemas/pair/p4_contract_record.schema.json",
  "title": "PAIR P4 compact contract summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "run_id", "split", "contract_id", "base_contract_id",
    "branch_kind", "category", "suite", "task_id", "trajectory_id", "horizon", "profile_id",
    "intervention_record_ids", "signed_contract_regret", "positive_contract_regret",
    "mean_action_l1_distortion", "maximum_action_abs_distortion", "mean_gripper_coordinate_error",
    "exact_repeat", "technical_valid", "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "pair-p4-contract-v1"},
    "record_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "calibration"]},
    "contract_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "base_contract_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "branch_kind": {"enum": ["base", "partition_a", "partition_b", "repeat"]},
    "category": {"enum": ["all_fresh_control", "atomic", "structured"]},
    "suite": {"enum": ["libero_spatial", "libero_object", "libero_goal", "libero_10"]},
    "task_id": {"type": "string", "minLength": 1},
    "trajectory_id": {"type": "string", "minLength": 1},
    "horizon": {"enum": [1, 2, 4]},
    "profile_id": {"const": "D62_BAL_PT1"},
    "intervention_record_ids": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "signed_contract_regret": {"type": "number"},
    "positive_contract_regret": {"type": "number", "minimum": 0},
    "mean_action_l1_distortion": {"type": "number", "minimum": 0},
    "maximum_action_abs_distortion": {"type": "number", "minimum": 0},
    "mean_gripper_coordinate_error": {"type": "number", "minimum": 0},
    "exact_repeat": {"type": "boolean"},
    "repeat_of_contract_id": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "technical_valid": {"const": true},
    "created_at_utc": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"not": {"required": ["success"]}}, {"not": {"required": ["reward"]}},
    {"not": {"required": ["expert_actions"]}}, {"not": {"required": ["dense_actions"]}}
  ]
}
