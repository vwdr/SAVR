{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://savr.local/schemas/pair/p4_feature_record.schema.json",
  "title": "PAIR P4 deployment-available feature record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "run_id", "split", "contract_id",
    "base_intervention_record_id", "suite", "task_id", "trajectory_id",
    "query_ordinal", "horizon", "profile_id", "features", "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "pair-p4-feature-v1"},
    "record_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "calibration"]},
    "contract_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "base_intervention_record_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "suite": {"enum": ["libero_spatial", "libero_object", "libero_goal", "libero_10"]},
    "task_id": {"type": "string", "minLength": 1},
    "trajectory_id": {"type": "string", "minLength": 1},
    "query_ordinal": {"type": "integer", "minimum": 1, "maximum": 4},
    "horizon": {"enum": [1, 2, 4]},
    "profile_id": {"const": "D62_BAL_PT1"},
    "features": {
      "type": "object", "additionalProperties": false,
      "required": ["global_continuous", "groups"],
      "properties": {
        "global_continuous": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"type": "number"}},
        "groups": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["camera", "tile", "onset_layer", "profile_id", "horizon", "continuous"],
            "properties": {
              "camera": {"enum": ["primary", "wrist"]},
              "tile": {"type": "integer", "minimum": 0, "maximum": 15},
              "onset_layer": {"enum": [2, 6, 9, 11]},
              "profile_id": {"const": "D62_BAL_PT1"},
              "horizon": {"enum": [1, 2, 4]},
              "continuous": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"type": "number"}}
            }
          }
        }
      }
    },
    "created_at_utc": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"not": {"required": ["success"]}}, {"not": {"required": ["reward"]}},
    {"not": {"required": ["expert_actions"]}}, {"not": {"required": ["dense_actions"]}}
  ]
}
