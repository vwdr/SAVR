{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://savr.local/schemas/pair/technical_record.schema.json",
  "title": "PAIR outcome-free technical correctness record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_id", "run_id", "phase", "check_id",
    "status", "synthetic", "cuda_visible", "model_accessed",
    "checkpoint_accessed", "simulator_accessed", "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "pair-technical-v1"},
    "record_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "phase": {"const": "P2"},
    "check_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["passed", "failed_closed"]},
    "synthetic": {"const": true},
    "cuda_visible": {"const": false},
    "model_accessed": {"const": false},
    "checkpoint_accessed": {"const": false},
    "simulator_accessed": {"const": false},
    "details": {"type": "object"},
    "created_at_utc": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"not": {"required": ["success"]}},
    {"not": {"required": ["terminal_success"]}},
    {"not": {"required": ["reward"]}},
    {"not": {"required": ["task_success"]}},
    {"not": {"required": ["episode_outcome"]}}
  ]
}
