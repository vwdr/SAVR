{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vwdr/SAVR/schemas/acr_run.schema.json",
  "title": "ACR Immutable Run Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "phase",
    "policy",
    "suite",
    "scope",
    "status",
    "configuration_sha256",
    "revisions",
    "schemas",
    "population",
    "resource_caps",
    "planned_attempts",
    "recovery",
    "artifact_root",
    "started_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "acr.run.v1"},
    "run_id": {"type": "string", "pattern": "^acr-a[3-8]-[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]{2}$"},
    "phase": {"type": "string", "enum": ["A3", "A4", "A5", "A6", "A7", "A8"]},
    "policy": {"type": "string", "enum": ["upstream-fr", "factorized-fr", "sa-acr", "scene-visual-acr", "scene-periodic-acr", "mixed"]},
    "suite": {"type": ["string", "null"], "enum": ["libero_spatial", "libero_object", "libero_goal", "libero_10", "all", null]},
    "scope": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["planned", "running", "completed", "failed", "interrupted"]},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["savr", "openvla_oft", "libero", "checkpoint"],
      "properties": {
        "savr": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "openvla_oft": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "libero": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "checkpoint": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_sha256", "query_sha256", "episode_sha256"],
      "properties": {
        "run_sha256": {"$ref": "#/$defs/sha256"},
        "query_sha256": {"$ref": "#/$defs/sha256"},
        "episode_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_ids", "initial_state_ids", "seed"],
      "properties": {
        "task_ids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 9}},
        "initial_state_ids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 49}},
        "seed": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "resource_caps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_count", "model_processes", "query_attempts", "episode_attempts", "wall_seconds", "artifact_bytes", "downloads_allowed"],
      "properties": {
        "gpu_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "model_processes": {"type": "integer", "minimum": 0, "maximum": 1},
        "query_attempts": {"type": ["integer", "null"], "minimum": 0},
        "episode_attempts": {"type": ["integer", "null"], "minimum": 0},
        "wall_seconds": {"type": "integer", "minimum": 0},
        "artifact_bytes": {"type": "integer", "minimum": 0},
        "downloads_allowed": {"const": false}
      }
    },
    "planned_attempts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^acr-a[3-8]-.+/attempt-[0-9]{4}$"}},
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "overwrite_allowed", "resume_incomplete_episode", "next_attempt_index"],
      "properties": {
        "mode": {"const": "preserve-and-restart"},
        "overwrite_allowed": {"const": false},
        "resume_incomplete_episode": {"const": false},
        "next_attempt_index": {"type": "integer", "minimum": 1}
      }
    },
    "artifact_root": {"type": "string", "pattern": "^/home/ved/SAVR/results/acr-a[3-8]-[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]{2}$"},
    "command": {"type": ["string", "null"]},
    "host": {"type": ["string", "null"]},
    "selected_gpu_id": {"type": ["integer", "null"], "minimum": 0},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "finished_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "records_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
