{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vwdr/SAVR/schemas/acr_episode.schema.json",
  "title": "ACR Immutable Episode Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "episode_id",
    "phase",
    "policy",
    "suite",
    "task_id",
    "initial_state_id",
    "seed",
    "status",
    "success",
    "failure_classification",
    "counts",
    "timing",
    "memory",
    "records_sha256",
    "configuration_sha256",
    "started_at_utc",
    "finished_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "acr.episode.v1"},
    "run_id": {"type": "string", "pattern": "^acr-a[4-8]-[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]{2}$"},
    "attempt_id": {"type": "string", "pattern": "^acr-a[4-8]-.+/task-[0-9]{2}/state-[0-9]{2}/seed-[0-9]+/attempt-[0-9]{4}$"},
    "episode_id": {"type": "string", "pattern": "^acr-a[4-8]-.+/task-[0-9]{2}/state-[0-9]{2}/seed-[0-9]+/attempt-[0-9]{4}/episode$"},
    "phase": {"type": "string", "enum": ["A4", "A5", "A6", "A7", "A8"]},
    "policy": {"type": "string", "enum": ["upstream-fr", "sa-acr", "scene-visual-acr", "scene-periodic-acr"]},
    "suite": {"type": "string", "enum": ["libero_spatial", "libero_object", "libero_goal", "libero_10"]},
    "task_id": {"type": "integer", "minimum": 0, "maximum": 9},
    "initial_state_id": {"type": "integer", "minimum": 0, "maximum": 49},
    "seed": {"type": "integer", "minimum": 0},
    "status": {"type": "string", "enum": ["completed", "failed", "interrupted"]},
    "success": {"type": ["boolean", "null"]},
    "failure_classification": {"type": ["string", "null"], "enum": ["scientific", "technical", "invariant", "resource", "operator", null]},
    "failure_reason": {"type": ["string", "null"]},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_steps", "queries", "scene_refreshes", "scene_reuses", "wrist_refreshes", "scene_siglip_calls", "scene_dinov2_calls", "scene_projector_calls", "wrist_siglip_calls", "wrist_dinov2_calls", "wrist_projector_calls", "downstream_calls"],
      "properties": {
        "environment_steps": {"type": "integer", "minimum": 0},
        "queries": {"type": "integer", "minimum": 0},
        "scene_refreshes": {"type": "integer", "minimum": 0},
        "scene_reuses": {"type": "integer", "minimum": 0},
        "wrist_refreshes": {"type": "integer", "minimum": 0},
        "scene_siglip_calls": {"type": "integer", "minimum": 0},
        "scene_dinov2_calls": {"type": "integer", "minimum": 0},
        "scene_projector_calls": {"type": "integer", "minimum": 0},
        "wrist_siglip_calls": {"type": "integer", "minimum": 0},
        "wrist_dinov2_calls": {"type": "integer", "minimum": 0},
        "wrist_projector_calls": {"type": "integer", "minimum": 0},
        "downstream_calls": {"type": "integer", "minimum": 0}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_wall_ms", "inclusive_query_wall_ms", "steady_query_wall_ms", "inclusive_visual_cuda_ms", "steady_visual_cuda_ms"],
      "properties": {
        "episode_wall_ms": {"type": "number", "minimum": 0},
        "inclusive_query_wall_ms": {"type": ["array", "null"], "items": {"type": "number", "minimum": 0}},
        "steady_query_wall_ms": {"type": ["array", "null"], "items": {"type": "number", "minimum": 0}},
        "inclusive_visual_cuda_ms": {"type": ["array", "null"], "items": {"type": "number", "minimum": 0}},
        "steady_visual_cuda_ms": {"type": ["array", "null"], "items": {"type": "number", "minimum": 0}}
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peak_allocated_bytes", "peak_reserved_bytes", "scene_cache_bytes"],
      "properties": {
        "peak_allocated_bytes": {"type": ["integer", "null"], "minimum": 0},
        "peak_reserved_bytes": {"type": ["integer", "null"], "minimum": 0},
        "scene_cache_bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "records_sha256": {"$ref": "#/$defs/sha256"},
    "trajectory_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "finished_at_utc": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
