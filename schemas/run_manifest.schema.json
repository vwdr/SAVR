{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vwdr/SAVR/schemas/run_manifest.schema.json",
  "title": "SAVR Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "started_at_utc",
    "status",
    "policy",
    "savr_git_revision",
    "base_model",
    "benchmark",
    "hardware",
    "software",
    "configuration"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "finished_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "status": {
      "type": "string",
      "enum": ["planned", "running", "completed", "failed", "interrupted"]
    },
    "policy": {"type": "string", "enum": ["FR", "PR", "VOR", "SAVR", "SAVR2", "MIXED"]},
    "savr_git_revision": {"type": "string", "minLength": 7},
    "working_tree_clean": {"type": "boolean"},
    "base_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "checkpoint", "revision"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "checkpoint": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision", "suite"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "suite": {"type": "string", "minLength": 1}
      }
    },
    "hardware": {"type": "object"},
    "software": {"type": "object"},
    "configuration": {"type": "object"},
    "normalization_statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unnorm_key",
        "state_q01",
        "state_q99",
        "action_q01",
        "action_q99"
      ],
      "properties": {
        "unnorm_key": {"type": "string", "minLength": 1},
        "state_q01": {"type": "array", "items": {"type": "number"}},
        "state_q99": {"type": "array", "items": {"type": "number"}},
        "action_q01": {"type": "array", "items": {"type": "number"}},
        "action_q99": {"type": "array", "items": {"type": "number"}}
      }
    },
    "command": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]}
  }
}
