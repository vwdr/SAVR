{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vwdr/SAVR/schemas/acr_query.schema.json",
  "title": "ACR Immutable Query Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "query_id",
    "phase",
    "policy",
    "suite",
    "task_id",
    "initial_state_id",
    "seed",
    "query_index",
    "environment_step",
    "status",
    "decision",
    "inputs",
    "camera_work",
    "timing",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "acr.query.v1"},
    "run_id": {"type": "string", "pattern": "^acr-a[3-8]-[a-z0-9]+(?:-[a-z0-9]+)*-v[0-9]{2}$"},
    "attempt_id": {"type": "string", "pattern": "^acr-a[3-8]-.+/task-[0-9]{2}/state-[0-9]{2}/seed-[0-9]+/attempt-[0-9]{4}$"},
    "query_id": {"type": "string", "pattern": "^acr-a[3-8]-.+/task-[0-9]{2}/state-[0-9]{2}/seed-[0-9]+/attempt-[0-9]{4}/query-[0-9]{6}$"},
    "phase": {"type": "string", "enum": ["A3", "A4", "A5", "A6", "A7", "A8"]},
    "policy": {"type": "string", "enum": ["upstream-fr", "factorized-fr", "sa-acr", "scene-visual-acr", "scene-periodic-acr"]},
    "suite": {"type": ["string", "null"], "enum": ["libero_spatial", "libero_object", "libero_goal", "libero_10", null]},
    "task_id": {"type": ["integer", "null"], "minimum": 0, "maximum": 9},
    "initial_state_id": {"type": ["integer", "null"], "minimum": 0, "maximum": 49},
    "seed": {"type": ["integer", "null"], "minimum": 0},
    "query_index": {"type": "integer", "minimum": 0},
    "environment_step": {"type": ["integer", "null"], "minimum": 0},
    "status": {"type": "string", "enum": ["completed", "failed", "interrupted"]},
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["classification", "message"],
      "properties": {
        "classification": {"type": "string", "enum": ["technical", "invariant", "resource", "operator"]},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scene_refresh",
        "refresh_reasons",
        "cache_age_before",
        "cache_age_after",
        "reference_query_index",
        "scene_score",
        "scene_threshold",
        "translation_score",
        "translation_threshold",
        "gripper_transition_veto",
        "horizon",
        "reuse_count_before",
        "query_count_before",
        "hard_reuse_cap"
      ],
      "properties": {
        "scene_refresh": {"type": "boolean"},
        "refresh_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["cache", "invalid-signal", "warm-up", "scene-change", "translation", "gripper-transition", "horizon", "hard-cap", "policy"]
          }
        },
        "cache_age_before": {"type": ["integer", "null"], "minimum": 0},
        "cache_age_after": {"type": ["integer", "null"], "minimum": 0},
        "reference_query_index": {"type": ["integer", "null"], "minimum": 0},
        "scene_score": {"type": ["number", "null"], "minimum": 0},
        "scene_threshold": {"type": ["number", "null"], "minimum": 0},
        "translation_score": {"type": ["number", "null"], "minimum": 0},
        "translation_threshold": {"type": ["number", "null"], "minimum": 0},
        "gripper_transition_veto": {"type": ["boolean", "null"]},
        "horizon": {"type": ["integer", "null"], "minimum": 1},
        "reuse_count_before": {"type": "integer", "minimum": 0},
        "query_count_before": {"type": "integer", "minimum": 0},
        "hard_reuse_cap": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_image_sha256", "wrist_image_sha256", "proprio_sha256", "action_sha256", "context_sha256"],
      "properties": {
        "scene_image_sha256": {"$ref": "#/$defs/sha256"},
        "wrist_image_sha256": {"$ref": "#/$defs/sha256"},
        "proprio_sha256": {"$ref": "#/$defs/sha256"},
        "action_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "context_sha256": {"$ref": "#/$defs/sha256"},
        "scene_representation": {"type": ["string", "null"]},
        "scene_patch_scores": {"type": ["array", "null"], "minItems": 64, "maxItems": 64, "items": {"type": "number", "minimum": 0}},
        "proprio_raw": {"type": ["array", "null"], "minItems": 8, "maxItems": 8, "items": {"type": "number"}},
        "proprio_normalized": {"type": ["array", "null"], "minItems": 8, "maxItems": 8, "items": {"type": "number"}},
        "direction_reversal": {"type": ["boolean", "null"]}
      }
    },
    "camera_work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_siglip_calls", "scene_dinov2_calls", "scene_projector_calls", "wrist_siglip_calls", "wrist_dinov2_calls", "wrist_projector_calls", "visual_token_count", "token_order", "dtype", "device", "downstream_calls"],
      "properties": {
        "scene_siglip_calls": {"type": "integer", "minimum": 0, "maximum": 1},
        "scene_dinov2_calls": {"type": "integer", "minimum": 0, "maximum": 1},
        "scene_projector_calls": {"type": "integer", "minimum": 0, "maximum": 1},
        "wrist_siglip_calls": {"type": "integer", "minimum": 0, "maximum": 1},
        "wrist_dinov2_calls": {"type": "integer", "minimum": 0, "maximum": 1},
        "wrist_projector_calls": {"type": "integer", "minimum": 0, "maximum": 1},
        "visual_token_count": {"type": ["integer", "null"], "minimum": 0},
        "token_order": {"type": ["string", "null"], "enum": ["scene-wrist", null]},
        "dtype": {"type": ["string", "null"]},
        "device": {"type": ["string", "null"]},
        "downstream_calls": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inclusive", "controller_wall_ms", "cache_concat_wall_ms", "scene_visual_cuda_ms", "wrist_visual_cuda_ms", "total_visual_cuda_ms", "downstream_cuda_ms", "query_cuda_ms", "query_wall_ms"],
      "properties": {
        "inclusive": {"type": "boolean"},
        "controller_wall_ms": {"$ref": "#/$defs/nonnegativeOrNull"},
        "cache_concat_wall_ms": {"$ref": "#/$defs/nonnegativeOrNull"},
        "scene_visual_cuda_ms": {"$ref": "#/$defs/nonnegativeOrNull"},
        "wrist_visual_cuda_ms": {"$ref": "#/$defs/nonnegativeOrNull"},
        "total_visual_cuda_ms": {"$ref": "#/$defs/nonnegativeOrNull"},
        "downstream_cuda_ms": {"$ref": "#/$defs/nonnegativeOrNull"},
        "query_cuda_ms": {"$ref": "#/$defs/nonnegativeOrNull"},
        "query_wall_ms": {"$ref": "#/$defs/nonnegativeOrNull"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_sha256", "savr_revision", "openvla_oft_revision", "checkpoint_revision", "recorded_at_utc"],
      "properties": {
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "savr_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "openvla_oft_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "checkpoint_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "recorded_at_utc": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonnegativeOrNull": {"type": ["number", "null"], "minimum": 0}
  }
}
