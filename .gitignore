.ruff_cache/
.venv/
build/
*.egg-info/

# Local environments and credentials
.env
.env.*
!.env.example
.conda/
.micromamba/
envs/
cache/
third_party/

# Models, datasets, and generated results
checkpoints/
data/
datasets/
results/*
!results/.gitkeep
artifacts/*
!artifacts/.gitkeep

# Generated environment inventories and runtime logs
environment/locks/*
!environment/locks/.gitkeep
!environment/locks/conda-linux-64-explicit.txt
!environment/locks/pip-freeze.txt
reports/runtime/

# Editors and OS
.DS_Store
.idea/
.vscode/

# Scratch, redundant backups and protected raw contract schedules
/tmp/
/reports/*.tar.gz
/output/**/*.zip
/reports/cac_c0_recovery01/*.jsonl

